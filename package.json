{
  "name": "printemps",
  "version": "0.1.1",
  "private": true,
  "description": "A local audio separation and listening workspace",
  "desktopName": "com.means88.printemps.desktop",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/verify-package-inputs.mjs && pnpm run build && electron-builder --dir --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "dist": "node scripts/verify-package-inputs.mjs && pnpm run build && electron-builder --publish never",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "preview:ui": "vite --config scripts/preview.vite.mjs",
    "lint:design": "node scripts/design-lint.mjs",
    "lint": "oxlint && node scripts/design-lint.mjs"
  },
  "build": {
    "appId": "com.means88.printemps",
    "productName": "Printemps",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "public/brand/icon.png",
      "minimumSystemVersion": "14.0"
    },
    "win": {
      "target": "nsis",
      "icon": "public/brand/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "syncDesktopName": true,
      "category": "AudioVideo",
      "icon": "public/brand/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Means88",
        "repo": "printemps",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": ".runtime/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "worker",
        "to": "worker",
        "filter": [
          "**/*.py",
          "**/*.json",
          "**/LICENSE",
          "assets/*.ckpt",
          "**/*.cjs"
        ]
      },
      {
        "from": ".runtime/manifest.json",
        "to": "runtime-manifest.json"
      },
      {
        "from": "node_modules/essentia.js/dist",
        "to": "worker/essentia",
        "filter": [
          "essentia-wasm.umd.js",
          "essentia.js-core.umd.js"
        ]
      },
      {
        "from": "node_modules/essentia.js/LICENSE",
        "to": "worker/essentia/LICENSE"
      }
    ],
    "appImage": {
      "executableArgs": []
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "electron-updater": "^6.8.9",
    "essentia.js": "0.1.3",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.6.0"
  }
}
